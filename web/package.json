{
  "name": "closet-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "e2e": "playwright test",
    "icons": "node scripts/icons.mjs",
    "db:types": "supabase gen types typescript --local > lib/database.types.ts && prettier --write lib/database.types.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "dev:user": "node scripts/dev-user.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.21.0"
}
